# Taming and Release 4Ever By ZentosPlay - https://www.youtube.com/@ZentosPlay
# RELEASE + RE-TAMING FOREVER (DUAL PET VERSION)
# Plays until you manually pause it
# Releases pet 1, releases pet 2, tames pet 1, tames pet 2, repeat.
########################################
# V 10.0  - Last Updated: 03/06/2026 ##
########################################
@setvar! tameDelay 4500
@setvar! releaseDelay 500
########################################
### SELECT PET 1
########################################
overhead 'SELECT PET 1 - Click your first pet now!' 88
sysmsg 'SELECT PET 1: Click your FIRST pet.'
wait 500
setvar 'trainPet1'
useobject 'trainPet1'
wait 500
overhead 'PET 1 SELECTED!' 68
sysmsg 'Pet 1 locked in. Get ready to select Pet 2...'
wait 2000
########################################
### SELECT PET 2
########################################
overhead 'SELECT PET 2 - Click your second pet now!' 88
sysmsg 'SELECT PET 2: Click your SECOND pet (must be a DIFFERENT pet).'
wait 500
setvar 'trainPet2'
useobject 'trainPet2'
wait 500
overhead 'PET 2 SELECTED! Starting loop...' 68
sysmsg 'Pet 2 locked in. Starting in 3 seconds...'
wait 3000
########################################
### LOOP
########################################
while not dead
    ################################
    ### RELEASE PET 1
    ################################
    overhead 'Releasing Pet 1...' 88
    say 'a husk crab release'
    wait 250
    waitforgump 2426193729 3000
    gumpresponse 1
    wait releaseDelay

    ################################
    ### RELEASE PET 2
    ################################
    overhead 'Releasing Pet 2...' 88
    say 'TrainPet release'
    wait 250
    waitforgump 2426193729 3000
    gumpresponse 1
    wait releaseDelay

    ################################
    ### TAME PET 1
    ################################
    overhead 'Taming Pet 1...' 68
    hotkey 'Animal Taming'
    waitfortarget 1500
    target 'trainPet1'
    wait tameDelay

    ################################
    ### TAME PET 2
    ################################
    overhead 'Taming Pet 2...' 68
    hotkey 'Animal Taming'
    waitfortarget 1500
    target 'trainPet2'
    wait tameDelay

endwhile
